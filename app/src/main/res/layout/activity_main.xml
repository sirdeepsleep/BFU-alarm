<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stub_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stub_desc"
            android:textColor="#888888"
            android:textSize="15sp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_package_name"
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stub_how_it_works"
            android:textColor="#777777"
            android:textSize="11sp"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/btn_download_stub"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/blocker_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etPermPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_perm_package"
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnGeneratePerm"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/btn_download_blocker"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocker_desc_1"
            android:textColor="#AAAAAA"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/blocker_desc_2"
            android:textColor="#AAAAAA"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFEB3B"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play_protect_warning"
            android:textColor="#FFC107" 
            android:textSize="15sp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnOpenPlayStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_play_store"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnOpenPlayServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_play_services"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnOpenGsf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_gsf"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_warning"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnOpenDeviceAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_device_admin"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/retry_after_disable"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvLinkKeepAndroidOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keep_android_open_text"
            android:textColor="#42A5F5"
            android:textSize="15sp"
            android:autoLink="web"
            android:linksClickable="true"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>
